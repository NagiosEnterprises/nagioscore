			text-transform: uppercase;
		}
		.who { flex: 1; min-width: 0; line-height: 1.3; }
		.who b { display: block; color: var(--text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
		.icon-btn {
			flex: none;
			display: grid;
			place-items: center;
			width: 36px;
