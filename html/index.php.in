		}
		.brand .status-dots { display: flex; gap: 5px; }
		.brand .status-dots span { width: 7px; height: 7px; border-radius: 50%; }
		.brand .status-dots span:nth-child(1) { background: var(--ok); }
		.brand .status-dots span:nth-child(2) { background: var(--warning); }
		.brand .status-dots span:nth-child(3) { background: var(--critical); }
		.sidebar .nav {
			flex: 1;
			min-height: 0;
			overflow-y: auto;
