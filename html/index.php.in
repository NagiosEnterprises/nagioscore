			z-index: 5;
		}
		.loading .loading-bar { width: 80%; opacity: 1; }
		.scrim { display: none; }

		@media (max-width: 900px) {
			.shell { grid-template-columns: 1fr; }
			.sidebar {
				position: fixed;
				inset: 0 auto 0 0;
				width: min(300px, 86vw);
