	<title>Nagios: <?php echo htmlspecialchars($_SERVER['SERVER_NAME']); ?></title>
	<link rel="shortcut icon" href="images/favicon.ico" type="image/ico">
	<link rel="stylesheet" href="stylesheets/common.css?<?php echo $this_version; ?>">
	<script>
		// Apply a theme picked with the toggle before anything is painted.
		try {
			var t = localStorage.getItem('nagios-theme');
			if (t === 'dark' || t === 'light' || t === 'auto')
				document.documentElement.className = t === 'auto' ? '' : t;
		} catch (e) {}
	</script>
	<style>
		:root { --sidebar: 256px; --topbar: 56px; }
		html, body { height: 100%; }
		body {
			margin: 0;
