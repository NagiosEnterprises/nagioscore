		}
		.icon-btn:hover { color: var(--text); background: var(--surface-hover); filter: none; }
		.icon-btn svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
		/* the toggle shows the active mode: auto (OS), dark or light */
		.theme-toggle svg { display: none; }
		:root:not(.dark):not(.light) .theme-toggle .auto,
		.dark .theme-toggle .moon,
		.light .theme-toggle .sun { display: block; }

		.content { position: relative; min-width: 0; display: flex; flex-direction: column; }
		.topbar { display: none; }
		iframe[name="main"] {
			flex: 1;
			width: 100%;
			border: 0;
			background: var(--bg);
		}
		.loading-bar {
			position: absolute;
