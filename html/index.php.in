	<main class="content">
		<header class="topbar">
			<button type="button" class="icon-btn" id="menu-btn" aria-label="Open menu" aria-controls="sidebar" aria-expanded="false">
				<svg viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
			</button>
			<div class="title" id="page-title">Nagios</div>
			<span class="nav-badge" id="badge-top" hidden></span>
		</header>
		<div class="loading-bar" aria-hidden="true"></div>
		<iframe src="<?php echo $url; ?>" name="main" id="main-frame" title="Nagios content"></iframe>
	</main>
</div>

<script>
(function() {
	var root = document.documentElement;
	var shell = document.getElementById('shell');
	var frame = document.getElementById('main-frame');
	var cgi = <?php echo json_encode($cfg['cgi_base_url']); ?>;
	var mobile = window.matchMedia('(max-width: 900px)');

	/* ---- theme ---- */
	// '' = follow the OS (prefers-color-scheme), 'dark' / 'light' = forced
	function currentMode() {
		return root.classList.contains('dark') ? 'dark' : root.classList.contains('light') ? 'light' : '';
	}
	var themeBtn = document.getElementById('theme-toggle');
	var modeLabel = { '': 'Theme: automatic (system)', dark: 'Theme: dark', light: 'Theme: light' };
	function labelToggle() {
		themeBtn.title = modeLabel[currentMode()];
		themeBtn.setAttribute('aria-label', modeLabel[currentMode()]);
	}
	labelToggle();
	themeBtn.addEventListener('click', function() {
		var next = { '': 'dark', dark: 'light', light: '' }[currentMode()];
		root.className = next;
		try { localStorage.setItem('nagios-theme', next || 'auto'); } catch (e) {}
		labelToggle();
		themeFrame(frame.contentDocument);
	});
	function themeFrame(doc) {
		if (!doc || !doc.documentElement) return;
		var el = doc.documentElement;
		el.classList.remove('dark', 'light');
		el.classList.add('in-shell');
		if (currentMode()) el.classList.add(currentMode());
	}

	/* ---- mobile drawer ---- */
	var menuBtn = document.getElementById('menu-btn');
	function setNav(open) {
		shell.classList.toggle('nav-open', open);
		menuBtn.setAttribute('aria-expanded', open);
	}
	menuBtn.addEventListener('click', function() { setNav(!shell.classList.contains('nav-open')); });
	document.getElementById('scrim').addEventListener('click', function() { setNav(false); });
	document.addEventListener('keydown', function(e) { if (e.key === 'Escape') setNav(false); });
	document.getElementById('sidebar').addEventListener('click', function(e) {
		var a = e.target.closest('a');
		if (a && a.target === 'main') {
			setNav(false);
			shell.classList.add('loading');
		}
	});
	document.querySelector('.nav-search').addEventListener('submit', function() {
		setNav(false);
		shell.classList.add('loading');
	});

	/* ---- highlight the menu entry of the page shown in the frame ---- */
	var links = Array.prototype.slice.call(document.querySelectorAll('.nav a[target=main]'));
	function markActive(loc) {
		var params = new URLSearchParams(loc.search), best = null, bestScore = -1;
		links.forEach(function(a) {
			a.classList.remove('active');
			var u = new URL(a.href, location.href), score = 0, ok = u.pathname === loc.pathname;
			// the most specific link whose query parameters all match wins
			u.searchParams.forEach(function(v, k) {
				if (params.get(k) === v) score++; else ok = false;
			});
			if (ok && score > bestScore) { best = a; bestScore = score; }
		});
		if (best) best.classList.add('active');
	}

	/* ---- make wide tables scroll inside the page instead of the page itself ---- */
	function wrapWideTables(doc) {
		var body = doc.body;
		if (!body) return;
		var width = body.clientWidth;
		Array.prototype.forEach.call(doc.querySelectorAll('table'), function(t) {
			if (t.parentElement.closest('table') || t.parentElement.classList.contains('table-scroll')) return;
			if (t.offsetWidth <= width + 1) return;
			var w = doc.createElement('div');
			w.className = 'table-scroll';
			t.parentNode.insertBefore(w, t);
			w.appendChild(t);
		});
	}

	/* ---- frame lifecycle ---- */
	var watched = null;
	function watchForNewDocument() {
		// Theme the next document as soon as it exists to avoid a flash.
		var old = frame.contentDocument;
		var tries = 0;
		(function poll() {
			var d = frame.contentDocument;
			if (d && d !== old && d.documentElement) { themeFrame(d); return; }
			if (++tries < 400) setTimeout(poll, 15);
		})();
	}
	frame.addEventListener('load', function() {
		shell.classList.remove('loading');
		var win, doc;
		try { win = frame.contentWindow; doc = frame.contentDocument; } catch (e) { return; }
		if (!doc) return;
		themeFrame(doc);
		wrapWideTables(doc);
		markActive(win.location);
		document.getElementById('page-title').textContent = (doc.title || 'Nagios').trim();
		document.title = 'Nagios: ' + (doc.title || '').trim();
		win.addEventListener('beforeunload', function() {
			shell.classList.add('loading');
			watchForNewDocument();
		});
		win.addEventListener('resize', function() { wrapWideTables(doc); });
	});

	/* ---- problem counters in the menu ---- */
	function badge(id, n, cls) {
		var el = document.getElementById(id);
		if (!el) return;
		el.hidden = !n;
		el.textContent = n;
		el.className = 'nav-badge ' + cls;
	}
	function refreshCounts() {
		Promise.all([
			fetch(cgi + '/statusjson.cgi?query=hostcount', { credentials: 'same-origin' }).then(function(r) { return r.json(); }),
			fetch(cgi + '/statusjson.cgi?query=servicecount', { credentials: 'same-origin' }).then(function(r) { return r.json(); })
		]).then(function(res) {
			var h = res[0].data.count, s = res[1].data.count;
			var hostProblems = h.down + h.unreachable;
			var svcProblems = s.critical + s.warning + s.unknown;
			badge('badge-hosts', hostProblems, 'crit');
			badge('badge-services', svcProblems, s.critical ? 'crit' : 'warn');
			badge('badge-problems', hostProblems + svcProblems, (h.down || s.critical) ? 'crit' : 'warn');
			badge('badge-top', hostProblems + svcProblems, (h.down || s.critical) ? 'crit' : 'warn');
		}).catch(function() {});
	}
	refreshCounts();
	setInterval(refreshCounts, 60000);
})();
</script>
</body>

</html>
