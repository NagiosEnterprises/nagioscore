			<div class="who"><b><?php echo htmlspecialchars($user); ?></b>Nagios Core <?php echo $this_version; ?></div>
<?php } else { ?>
			<div class="who"><b>Nagios Core</b><?php echo $this_version; ?></div>
<?php } ?>
			<button type="button" class="icon-btn theme-toggle" id="theme-toggle" aria-label="Theme">
				<svg class="auto" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 3a9 9 0 0 0 0 18z" fill="currentColor"/></svg>
				<svg class="moon" viewBox="0 0 24 24"><path d="M21 13A9 9 0 1 1 11 3a7 7 0 0 0 10 10z"/></svg>
				<svg class="sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
			</button>
		</div>
