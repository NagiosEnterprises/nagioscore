# SAMPLE CONFIG SNIPPETS FOR APACHE WEB SERVER
#
# This file contains examples of entries that need
# to be incorporated into your Apache web server
# configuration file.  Customize the paths, etc. as
# needed to fit your system.

# Public documentation and the token-authenticated MCP endpoint.
AliasMatch ^/mcp/help/?$ "@datadir@/mcp.php"
ScriptAliasMatch ^/mcp/?$ "@sbindir@/mcp.cgi"

ScriptAlias @cgiurl@ "@sbindir@"

<Directory "@sbindir@">
#  SSLRequireSSL
   Options ExecCGI
   AllowOverride None
   <IfVersion >= 2.3>
      <RequireAll>
         Require all granted
#        Require host 127.0.0.1

         AuthName "Nagios Access"
         AuthType Basic
         AuthUserFile @sysconfdir@/htpasswd.users
         Require valid-user
      </RequireAll>
   </IfVersion>
   <IfVersion < 2.3>
      Order allow,deny
      Allow from all
#     Order deny,allow
#     Deny from all
#     Allow from 127.0.0.1

      AuthName "Nagios Access"
      AuthType Basic
      AuthUserFile @sysconfdir@/htpasswd.users
      Require valid-user
   </IfVersion>

   # The MCP server (for AI assistants) authenticates its clients with its
   # own bearer tokens (see "mcp.cgi --create-token"), so Apache must not
   # ask for a password and must pass the Authorization header through.
   <Files "mcp.cgi">
      <IfVersion >= 2.4.13>
         Require all granted
         CGIPassAuth On
      </IfVersion>
      <IfVersion < 2.4.13>
         # CGIPassAuth needs Apache 2.4.13+; older versions need
         # mod_rewrite: RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
         Require all denied
      </IfVersion>
   </Files>
</Directory>

Alias @htmurl@ "@datadir@"

<Directory "@datadir@">
#  SSLRequireSSL
   Options None
   AllowOverride None
   <IfVersion >= 2.3>
      <RequireAll>
         Require all granted
#        Require host 127.0.0.1

         AuthName "Nagios Access"
         AuthType Basic
         AuthUserFile @sysconfdir@/htpasswd.users
         Require valid-user
      </RequireAll>
   </IfVersion>
   <IfVersion < 2.3>
      Order allow,deny
      Allow from all
#     Order deny,allow
#     Deny from all
#     Allow from 127.0.0.1

      AuthName "Nagios Access"
      AuthType Basic
      AuthUserFile @sysconfdir@/htpasswd.users
      Require valid-user
   </IfVersion>
</Directory>

# Public connection instructions contain no monitoring data or credentials.
<Directory "@datadir@">
   <Files "mcp.php">
      Require all granted
   </Files>
</Directory>
